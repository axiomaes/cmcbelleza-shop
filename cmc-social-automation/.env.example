# Server configuration
PORT=3000
WEBHOOK_SECRET=your_strong_secret_key_here

# Database connection string
DATABASE_URL=postgresql://user:password@localhost:5432/your_db

# Meta Graph API credentials
INSTAGRAM_BUSINESS_ID=123456789012345
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token

# Meta Permanent Token Auto-Refresh config
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_PAGE_ID=your_facebook_page_id
META_INITIAL_TOKEN=your_initial_user_token
META_TOKEN_REFRESH_API_KEY=your_endpoint_protection_key
